  {
    "name": "total_facility_amount",
    "dataType": "NUMBER",
    "parameterType": "DERIVED",
    "required": false,
    "description": "总贷款额度 (自动计算)",
    "expressionText": "data.facilities.reduce((sum, f) => sum + (f.amount || 0), 0)",
    "expressionType": "JAVASCRIPT"
  },
  {
    "name": "total_fee_amount",
    "dataType": "NUMBER",
    "parameterType": "DERIVED",
    "required": false,
    "description": "总费用金额 (自动计算)",
    "expressionText": "data.fees.reduce((sum, f) => sum + (f.amount || 0), 0)",
    "expressionType": "JAVASCRIPT"
  },
  {
    "name": "weighted_avg_rate",
    "dataType": "NUMBER",
    "parameterType": "DERIVED",
    "required": false,
    "description": "加权平均利率 (自动计算)",
    "expressionText": "data.facilities.reduce((s, f) => s + f.amount * f.interest_rate, 0) / data.facilities.reduce((s, f) => s + f.amount, 0)",
    "expressionType": "JAVASCRIPT"
  },
  {
    "name": "total_security_value",
    "dataType": "NUMBER",
    "parameterType": "DERIVED",
    "required": false,
    "description": "总抵押品价值 (自动计算)",
    "expressionText": "(data.security_items || []).reduce((sum, s) => sum + (s.estimated_value || 0), 0)",
    "expressionType": "JAVASCRIPT"
  },
  {
    "name": "overall_ltv",
    "dataType": "NUMBER",
    "parameterType": "DERIVED",
    "required": false,
    "description": "整体贷款价值比 (自动计算)",
    "expressionText": "data.total_security_value > 0 ? data.total_facility_amount / data.total_security_value : 0",
    "expressionType": "JAVASCRIPT"
  },
  {
    "name": "facility_count",
    "dataType": "NUMBER",
    "parameterType": "DERIVED",
    "required": false,
    "description": "设施数量 (Excel 公式演示)",
    "expressionText": "COUNT(data.facilities)",
    "expressionType": "EXCEL_FORMULA"
  },
  {
    "name": "max_tenor_months",
    "dataType": "NUMBER",
    "parameterType": "DERIVED",
    "required": false,
    "description": "最长期限 (月)",
    "expressionText": "Math.max(...data.facilities.map(f => f.tenor_months))",
    "expressionType": "JAVASCRIPT"
  },

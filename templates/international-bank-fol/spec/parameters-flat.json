  {
    "name": "document_ref",
    "dataType": "STRING",
    "parameterType": "REQUEST",
    "required": true,
    "description": "文档编号",
    "validationRules": {
      "not_blank": true,
      "pattern": "^FOL-\\d{4}-\\d{6}$",
      "custom_message": "文档编号格式: FOL-YYYY-NNNNNN"
    }
  },
  {
    "name": "document_date",
    "dataType": "DATE",
    "parameterType": "REQUEST",
    "required": true,
    "description": "文档日期",
    "validationRules": {
      "not_null": true,
      "date_format": "YYYY-MM-DD"
    }
  },
  {
    "name": "document_version",
    "dataType": "STRING",
    "parameterType": "REQUEST",
    "required": false,
    "defaultValue": "1.0",
    "description": "文档版本号"
  },
  {

# Local build: copy a pre-built JAR from the host (no Maven inside the image).
# Build the JAR first: cd backend && mvn clean package -DskipTests
# eclipse-temurin:17-jre-alpine includes BusyBox wget for health checks.
FROM eclipse-temurin:17-jre-alpine

RUN addgroup -S app && adduser -S app -G app -u 10001

WORKDIR /app
COPY target/*.jar app.jar
RUN chown app:app /app/app.jar

USER app
EXPOSE 8080
ENTRYPOINT ["java", "-jar", "app.jar"]

# ============================================
# DocGen 系统环境变量配置
# 复制此文件为 .env 并修改敏感值
# ============================================

# ---------- 数据库 (PostgreSQL) ----------
# Docker Compose 使用内置 PostgreSQL 容器
# K8s 部署时修改为公司自建数据库地址
DB_PASSWORD=change_me_db_password

# ---------- Redis ----------
REDIS_PASSWORD=change_me_redis_password

# ---------- MinIO 对象存储 ----------
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change_me_minio_secret

# ---------- JWT 认证 ----------
# 至少 256 位的随机字符串
JWT_SECRET=change_me_jwt_secret_at_least_256_bits

# ---------- AES-256 加密密钥 ----------
# 用于加密数据源敏感信息（API Key、密码等）
ENCRYPTION_KEY=change_me_aes256_encryption_key

# ---------- OnlyOffice ----------
ONLYOFFICE_JWT_SECRET=change_me_onlyoffice_jwt_secret
# 前端构建时注入的 OnlyOffice 地址（Vite 构建时变量）
VITE_ONLYOFFICE_URL=http://localhost:8443
# 后端内部地址，供 OnlyOffice 回调使用（Docker 内部网络地址）
VITE_BACKEND_INTERNAL_URL=http://app:8080

# ---------- SMTP 邮件 ----------
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# ---------- 安全沙箱 (Docxtemplater 服务) ----------
SANDBOX_TIMEOUT=5000
SANDBOX_MEMORY_LIMIT=64
